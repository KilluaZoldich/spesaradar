FROM python:3.13-slim@sha256:9d2e5553305c7c7b0097999bb17187c69b921ccd6bc9d40e4bb5ebe652c00285
WORKDIR /app
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 PYTHONPATH=/app/backend SPESARADAR_DB=/data/spesaradar.db
COPY requirements.lock ./
RUN pip install --no-cache-dir --require-hashes -r requirements.lock && useradd -u 10001 -m radar && mkdir /data && chown radar /data
COPY backend ./backend
COPY config ./config
COPY alembic.ini ./
COPY scripts ./scripts
USER radar
CMD ["uvicorn","app.api:app","--host","0.0.0.0","--port","8000","--no-access-log"]
